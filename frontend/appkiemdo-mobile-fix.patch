@@ -0,0 +1,26 @@
+import { Capacitor } from '@capacitor/core';
+
+// Địa chỉ máy chủ thật (backend ASP.NET đang chạy trên SmarterASP).
+// Nên đổi sang https:// khi bạn có chứng chỉ SSL (bắt buộc cho iOS khi lên App Store).
+const PRODUCTION_SERVER = 'http://sangop14-001-site1.ctempurl.com';
+
+// true khi đang chạy trong app Android/iOS (Capacitor), false khi chạy trên trình duyệt.
+export const IS_NATIVE = Capacitor.isNativePlatform();
+
+function resolveRootUrl() {
+    // Cho phép ép địa chỉ bằng biến môi trường: tạo file frontend/.env với dòng VITE_API_URL=https://...
+    if (import.meta.env.VITE_API_URL) return import.meta.env.VITE_API_URL;
+
+    // Trong app mobile, window.location.hostname cũng là "localhost" (đó là địa chỉ nội bộ của app),
+    // nên phải kiểm tra native TRƯỚC khi kiểm tra localhost.
+    if (IS_NATIVE) return PRODUCTION_SERVER;
+
+    // Chạy dev trên máy tính: backend ở localhost:5270.
+    if (window.location.hostname === 'localhost') return 'http://localhost:5270';
+
+    // Web đã deploy chung với backend: dùng đường dẫn gốc.
+    return '';
+}
+
+export const ROOT_URL = resolveRootUrl();
+export const API_BASE_URL = `${ROOT_URL}/api`;
